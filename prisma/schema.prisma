datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  category  String
  language  String   @default("sk")
  status    String   @default("Pending")
  imageUrl  String?
  date      String
  createdAt DateTime @default(now())
}